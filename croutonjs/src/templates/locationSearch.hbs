<button id="location-search-button" style="width: auto" class="location-search-button" title="{{getWord 'Open Location Search Dialog'}}">
    <span class="location-search-button-label" style="position:initial;">
        {{getWord 'Search by location'}}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-crosshair" viewBox="0 0 16 16" style="vertical-align: sub;">
            <path d="M8.5.5a.5.5 0 0 0-1 0v.518A7 7 0 0 0 1.018 7.5H.5a.5.5 0 0 0 0 1h.518A7 7 0 0 0 7.5 14.982v.518a.5.5 0 0 0 1 0v-.518A7 7 0 0 0 14.982 8.5h.518a.5.5 0 0 0 0-1h-.518A7 7 0 0 0 8.5 1.018zm-6.48 7A6 6 0 0 1 7.5 2.02v.48a.5.5 0 0 0 1 0v-.48a6 6 0 0 1 5.48 5.48h-.48a.5.5 0 0 0 0 1h.48a6 6 0 0 1-5.48 5.48v-.48a.5.5 0 0 0-1 0v.48A6 6 0 0 1 2.02 8.5h.48a.5.5 0 0 0 0-1zM8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
        </svg>
    </span>
</button>
<div id="bmlt_location_search_modal" class="modal" style="display: none;">
    <div id="bmlt_location_search_content" class="modal-content" style="border-color:unset;">
        <span id="close_location_search" class="modal-close">x</span>
        <div class="modal-title">{{getWord 'Search by location'}}</div>
        <div class="crouton-modal-search-page">
            <div id="modal-location-search-box" class="modal-search">
                <div>
                <input id="bmlt-location-search-goto-text" type="text" class="crouton-goto-text" autocomplete="off"
                    placeholder="{{getWord 'Enter a city or zip code'}}">
                </div>
                <button id="bmlt-location-search-text-button" class="filter-button">{{getWord 'text_search'}}</button>
            </div>
            <div class="modal-search">
                <button id="bmlt-location-search-nearbyMeetings" class="filter-button">{{getWord 'near_me'}}</button>
            </div>
            <div id="location-search-widen" class="modal-search">
                <button id="bmlt-location-search-widen" class="filter-button">{{getWord 'Widen Search'}}</button>
            </div>
            <div>
			    <!--<button id="location-search-close" class="advanced-search-button" style="float:left">{{getWord "Close"}}</a>-->
                <button id="bmlt-location_search-cancel" class="advanced-search-button">{{getWord 'Cancel Search'}}</button>
		    </div>
        </div>
        <div class="crouton-modal-search-choice"></div>
    </div>
</div>